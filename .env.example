# =======================================================
# CHÁ DE RIFA DO LAEL — VARIÁVEIS DE AMBIENTE
# Copie para .env e preencha. NUNCA comite segredos reais.
# =======================================================

# --- BACKEND ---
# Modo local (SQLite):
DATABASE_URL=sqlite:///./rifa_lael.db
# Modo produção (PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://lael:TROQUE_ESSA_SENHA@db:5432/chaderifa

# Chave secreta JWT — GERE UMA NOVA em produção (ex.: openssl rand -hex 32)
SECRET_KEY=troque-por-uma-chave-forte-e-unica

# Ambiente: development | production (production desliga dados DEMO)
ENVIRONMENT=development

# Dados de demonstração (produtos exemplificativos, NÃO reais).
# Em produção NÃO serão criados (ver docs/DECISIONS.md).
SEED_DEMO=true

# Primeiro administrador — criado no boot APENAS se ambos estiverem definidos.
# Alternativa: python -m backend.app.create_admin <email> <senha>
# NÃO existe senha padrão no sistema.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# CORS — origens do frontend separadas por vírgula
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Configurações de Negócio
DEFAULT_RESERVATION_HOURS=72
TOTAL_NUMBERS=100
EXPIRATION_WORKER_INTERVAL=60

# --- BANCO DE DADOS (DOCKER) ---
POSTGRES_USER=lael
POSTGRES_PASSWORD=troque-essa-senha-tambem
POSTGRES_DB=chaderifa

# --- FRONTEND ---
# Em produção atrás do proxy Caddy use /api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# --- PROXY (produção) ---
# Domínio publicado no Caddyfile (infra/Caddyfile)
SITE_DOMAIN=:80
